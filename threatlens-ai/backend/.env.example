# ThreatLens AI - Environment Configuration
# Copy this to .env and fill in your values

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/threatlens
SECRET_KEY=supersecretkey-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
MODEL_PATH=app/models/isolation_forest_final.pkl
SCALER_PATH=app/models/if_scaler.pkl
ANOMALY_THRESHOLD=-0.1
